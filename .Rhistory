library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)
tab.mu <- seq(0, 10, length.out = 200)
# ---------- (a) Tie probabilities ----------
tie_geom1 <- function(mu) 1/(2*mu + 1)                    # P(X = X' = X'')
tie_geom2 <- function(mu) exp(-2*mu) * besselI(2*mu, 0)   # P(X = X')
df_a <- tibble(
mu = tab.mu,
`P(X=X')`      = tie_geom2(tab.mu),
`P(X=X'=X'')`  = tie_geom1(tab.mu)
) |> pivot_longer(-mu, names_to="measure", values_to="value")
p_a <- ggplot(df_a, aes(mu, value, linetype = measure, color = measure)) +
geom_line(linewidth = 1.2) +
scale_linetype_manual(
values = c(`P(X=X')`="dotted", `P(X=X'=X'')`="solid"),
name = expression(Geom(1/(mu+1))~":")
) +
scale_color_manual(
values = c(`P(X=X')`="black", `P(X=X'=X'')`="grey40"),
guide = "none"   # keep a single legend (linetype)
) +
coord_cartesian(ylim = c(0, 1)) +
labs(x = expression(mu), y = "Tie probabilities", title="(a)") +
theme_bw(base_size = 14) +
theme(
plot.title = element_text(hjust = 0),
legend.position = c(0.58, 0.86),     # <<< position inside panel (adjust if needed)
legend.background = element_rect(fill = "white", color = "black"),
legend.key.width = unit(1.3, "cm"),
legend.key.height = unit(0.45, "cm"),
legend.title = element_text(size = 12),
legend.text  = element_text(size = 11)
)
# ---------- (b) Asymptotic variances ----------
# (placeholders – replace with your formulas)
rho_fun   <- function(mu) exp(-mu/2) + 0.2
tau_fun   <- function(mu) 0.5 * exp(-mu/4)
gamma_fun <- function(mu) 2/(mu + 1)
taub_fun  <- function(mu) 0.4 + 0.6/(mu + 2)
df_b <- tibble(
mu, rho = rho_fun(mu), tau = tau_fun(mu),
gamma = gamma_fun(mu), taub = taub_fun(mu)
) |> pivot_longer(-mu, names_to="measure", values_to="value")
