library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)
# --- Shared grid ---
tab.mu <- seq(0, 10, length.out = 200)
tie_geom1 <- function(mu) { 1 / (2*mu + 1) }
tie_geom2 <- function(mu) { exp(-2*mu) * besselI(2*mu, 0) }
df_a <- tibble(
mu = tab.mu,
`P(X=X')` = tie_geom2(tab.mu),
`P(X=X'=X'')` = tie_geom1(tab.mu)
) %>%
pivot_longer(cols = -mu, names_to = "measure", values_to = "value")
line_colors_a <- c(`P(X=X')` = "black", `P(X=X'=X'')` = "grey40")
line_types_a  <- c(`P(X=X')` = "dotted", `P(X=X'=X'')` = "solid")
p_a <- ggplot(df_a, aes(x = mu, y = value,
color = measure, linetype = measure)) +
geom_line(linewidth = 1.2) +
scale_color_manual(values = line_colors_a) +
scale_linetype_manual(values = line_types_a) +
labs(
x = expression(mu),
y = "Tie probabilities",
title = "(a)"
) +
coord_cartesian(ylim = c(0, 1)) +
theme_bw(base_size = 14) +
theme(
legend.title = element_blank(),
legend.position = "top",   # ✅ show legend above plot
plot.title = element_text(hjust = 0)
)
rho_fun   <- function(mu) { exp(-mu/2) + 0.2 }
tau_fun   <- function(mu) { 0.5 * exp(-mu/4) }
gamma_fun <- function(mu) { 2 / (mu + 1) }
taub_fun  <- function(mu) { 0.4 + 0.6/(mu + 2) }
df_b <- tibble(
mu = tab.mu,
rho = rho_fun(tab.mu),
tau = tau_fun(tab.mu),
gamma = gamma_fun(tab.mu),
taub = taub_fun(tab.mu)
) %>%
pivot_longer(cols = -mu, names_to = "measure", values_to = "value")
line_styles_b <- c("rho" = "dotted",
"tau" = "dotdash",
"gamma" = "dashed",
"taub" = "solid")
line_colors_b <- c("rho" = "black",
"tau" = "black",
"gamma" = "black",
"taub" = "grey40")
p_b <- ggplot(df_b, aes(x = mu, y = value,
linetype = measure, color = measure)) +
geom_line(linewidth = 1.2) +
geom_hline(yintercept = 1, linetype = "solid", color = "black", linewidth = 0.3) +
geom_hline(yintercept = 4/9, linetype = "solid", color = "black", linewidth = 0.3) +
scale_linetype_manual(
values = line_styles_b,
labels = c(expression(rho), expression(tau),
expression(gamma), expression(tau[b]))
) +
scale_color_manual(values = line_colors_b, guide = "none") +  # ✅ single legend (linetype only)
labs(
x = expression(mu),
y = "Asymptotic variance",
title = "(b)"
) +
coord_cartesian(ylim = c(0, 2.2)) +
theme_bw(base_size = 14) +
theme(
legend.title = element_blank(),
legend.text.align = 0,
legend.position = "top",  # unified legend on top
plot.title = element_text(hjust = 0)
)
final_plot <- p_a + p_b + plot_layout(widths = c(1, 1), guides = "collect") &
theme(legend.position = "top")
final_plot
final_plot <- p_a + p_b + plot_layout(widths = c(1, 1), guides = "collect") &
theme(
legend.position = c(0.85, 0.8),     # inside top-right corner
legend.background = element_rect(fill = "white", color = "grey70"),
legend.key.width = unit(1.4, "cm"),
legend.key.height = unit(0.5, "cm"),
legend.text = element_text(size = 12)
)
final_plot
final_plot <- p_a + p_b + plot_layout(widths = c(1, 1), guides = "collect") &
theme(
legend.position = c(0, 0.8),     # inside top-right corner
legend.background = element_rect(fill = "white", color = "grey70"),
legend.key.width = unit(1.4, "cm"),
legend.key.height = unit(0.5, "cm"),
legend.text = element_text(size = 12)
)
final_plot
final_plot <- p_a + p_b + plot_layout(widths = c(1, 1), guides = "collect") &
theme(
legend.position = "right",
legend.text = element_text(size = 12),
legend.key.width = unit(1.2, "cm"),
legend.key.height = unit(0.5, "cm")
)
final_plot
source("~/.active-rstudio-document", echo=TRUE)
library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)
tab.mu <- seq(0, 10, length.out = 200)
# ---------- (a) Tie probabilities ----------
tie_geom1 <- function(mu) 1/(2*mu + 1)                    # P(X = X' = X'')
tie_geom2 <- function(mu) exp(-2*mu) * besselI(2*mu, 0)   # P(X = X')
df_a <- tibble(
mu = tab.mu,
`P(X=X')`      = tie_geom2(tab.mu),
`P(X=X'=X'')`  = tie_geom1(tab.mu)
) |> pivot_longer(-mu, names_to="measure", values_to="value")
p_a <- ggplot(df_a, aes(mu, value, linetype = measure, color = measure)) +
geom_line(linewidth = 1.2) +
scale_linetype_manual(
values = c(`P(X=X')`="dotted", `P(X=X'=X'')`="solid"),
name = expression(Geom(1/(mu+1))~":")
) +
scale_color_manual(
values = c(`P(X=X')`="black", `P(X=X'=X'')`="grey40"),
guide = "none"   # keep a single legend (linetype)
) +
coord_cartesian(ylim = c(0, 1)) +
labs(x = expression(mu), y = "Tie probabilities", title="(a)") +
theme_bw(base_size = 14) +
theme(
plot.title = element_text(hjust = 0),
legend.position = c(0.58, 0.86),     # <<< position inside panel (adjust if needed)
legend.background = element_rect(fill = "white", color = "black"),
legend.key.width = unit(1.3, "cm"),
legend.key.height = unit(0.45, "cm"),
legend.title = element_text(size = 12),
legend.text  = element_text(size = 11)
)
# ---------- (b) Asymptotic variances ----------
# (placeholders – replace with your formulas)
rho_fun   <- function(mu) exp(-mu/2) + 0.2
tau_fun   <- function(mu) 0.5 * exp(-mu/4)
gamma_fun <- function(mu) 2/(mu + 1)
taub_fun  <- function(mu) 0.4 + 0.6/(mu + 2)
df_b <- tibble(
mu, rho = rho_fun(mu), tau = tau_fun(mu),
gamma = gamma_fun(mu), taub = taub_fun(mu)
) |> pivot_longer(-mu, names_to="measure", values_to="value")
